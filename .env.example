# docker compose 실행용 환경변수 템플릿.
# 이 파일을 .env로 복사한 뒤 실제 값을 채워 사용한다. .env는 .gitignore에 포함되어 커밋되지 않는다.

# MySQL root / 앱 DB 접속 공용 비밀번호 (application.yml의 DB_PASSWORD와 동일)
DB_PASSWORD=

# MySQL에 최초 생성할 데이터베이스명
MYSQL_DATABASE=duoinfra

JWT_SECRET=

PHYSICAL_SERVER_HOST=220.117.221.158
PHYSICAL_SERVER_PORT=22
PHYSICAL_SERVER_USERNAME=pi
PHYSICAL_SERVER_PASSWORD=

ADMIN_TEMP_EMAILS=

# Grafana 최초 admin 계정 비밀번호 (컨테이너 최초 기동 시 1회 적용됨).
# 이후 변경하려면 Grafana data 볼륨을 초기화하거나 Grafana UI/API에서 직접 변경해야 한다.
GRAFANA_ADMIN_PASSWORD=
